AUTH_SECRET=
DATABASE_URL=postgresql://applyra:password@localhost:5432/applyra

# Optional AI providers for Generate / sidebar tailor.
# Without keys, use “No API key — copy/paste ChatGPT” in the provider dropdown.
#
# Do NOT put real secrets in this file. Copy to .env.local (local) or set the
# same names in your host’s Environment Variables / Secrets (Vercel, etc.).
#
# OpenRouter keys look like sk-or-v1-… — set OPENAI_BASE_URL to OpenRouter:
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=openai/gpt-6-luna

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
